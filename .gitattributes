# ============================================================
# UE5 项目 Git LFS 配置
# 位置：项目根目录（与 .uproject 同级）
# 作用：大二进制文件交给 LFS，避免 Git 仓库膨胀
# ============================================================

# ------------------------------------------------------------
# 文本文件：强制统一换行符为 LF
# 作用：不管每个人本地 core.autocrlf 设成什么，Git 都按此规则
#       规范化。否则 Windows 队友之间会频繁出现「文件没改却显示
#       已修改 / 冲突」的假象（.gitignore 那次冲突就是这个原因）。
# 注意：二进制资产在下方已用 -text 标记，不受本段影响。
# ------------------------------------------------------------
*.ini            text eol=lf
*.uproject       text eol=lf
*.uplugin        text eol=lf
*.md             text eol=lf
*.txt            text eol=lf
*.json           text eol=lf
*.csv            text eol=lf
*.gitignore      text eol=lf
*.gitattributes  text eol=lf
*.bat            text eol=crlf
*.cmd            text eol=crlf

# --- 引擎资产（二进制，不可合并）---
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap   filter=lfs diff=lfs merge=lfs -text
*.ubulk  filter=lfs diff=lfs merge=lfs -text
*.uexp   filter=lfs diff=lfs merge=lfs -text
*.upk    filter=lfs diff=lfs merge=lfs -text
*.pak    filter=lfs diff=lfs merge=lfs -text

# --- 贴图 ---
*.png  filter=lfs diff=lfs merge=lfs -text
*.jpg  filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.tga  filter=lfs diff=lfs merge=lfs -text
*.exr  filter=lfs diff=lfs merge=lfs -text
*.hdr  filter=lfs diff=lfs merge=lfs -text
*.psd  filter=lfs diff=lfs merge=lfs -text

# --- 音频 ---
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text

# --- 三维模型 ---
*.fbx  filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
# AI 生成模型（Tripo / Hunyuan3D / Meshy 等）常见导出格式
*.glb  filter=lfs diff=lfs merge=lfs -text
*.gltf filter=lfs diff=lfs merge=lfs -text
*.obj  filter=lfs diff=lfs merge=lfs -text
*.usd  filter=lfs diff=lfs merge=lfs -text
*.usdz filter=lfs diff=lfs merge=lfs -text
*.stl  filter=lfs diff=lfs merge=lfs -text
*.3mf  filter=lfs diff=lfs merge=lfs -text

# --- 视频 ---
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text

# ============================================================
# 注意：以下类型不要加 LFS，它们是纯文本，需要能看 diff
#   *.uproject   *.ini   *.cpp   *.h   *.cs   *.json   *.md
# ============================================================
